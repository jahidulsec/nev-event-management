generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model approver {
  id            String        @id @default(nanoid()) @db.VarChar(21)
  event_type_id String        @db.VarChar(21)
  user_type     String        @db.VarChar(20)
  type          approver_type
  created_at    DateTime?     @default(now()) @db.Timestamp(0)
  updated_at    DateTime?     @default(now()) @db.Timestamp(0)
  event_type    event_type    @relation(fields: [event_type_id], references: [id], onUpdate: Restrict, map: "approver_ibfk_1")

  @@index([event_type_id], map: "event_type_id")
}

model doctor {
  id                String              @id @default(nanoid()) @db.VarChar(21)
  full_name         String              @db.VarChar(150)
  speciality        String              @db.VarChar(50)
  degrees           String?             @db.VarChar(50)
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  updated_at        DateTime?           @default(now()) @db.Timestamp(0)
  territory_code    String              @db.VarChar(6)
  area_name         String?             @db.VarChar(50)
  dr_master_id      String              @db.VarChar(8)
  dr_child_id       String?             @db.VarChar(8)
  chamber           String?             @db.Text
  event_consultant  event_consultant[]
  event_consultants event_consultants[]

  @@unique([territory_code, dr_child_id, dr_master_id], map: "doctor_index_2")
}

model event {
  id                    String                      @id @default(nanoid()) @db.VarChar(21)
  title                 String                      @db.VarChar(250)
  event_date            DateTime                    @db.DateTime(0)
  user_id               String                      @db.VarChar(10)
  product_id            String                      @db.VarChar(21)
  venue                 String                      @db.VarChar(255)
  food_supplier         String                      @db.VarChar(200)
  institute             String                      @db.VarChar(250)
  institute_unit        String?                     @db.VarChar(150)
  institute_dept        String                      @db.VarChar(150)
  objective             String                      @db.VarChar(150)
  type                  String                      @db.VarChar(100)
  internal_participants Int
  external_participants Int
  details_participants  String?                     @db.Text
  approved_material     event_approved_material
  material_code         String?                     @db.VarChar(200)
  current_status        event_current_status?       @default(processing)
  created_at            DateTime?                   @default(now()) @db.Timestamp(0)
  updated_at            DateTime?                   @default(now()) @db.Timestamp(0)
  other_participants    Int?
  venue_appropriateness event_venue_appropriateness
  track_no              String?                     @default("NULL") @db.VarChar(50)
  event_type_id         String?                     @db.VarChar(21)
  is_archived           event_is_archived?          @default(no)
  event_type            event_type?                 @relation(fields: [event_type_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "event_ibfk_3")
  user                  user                        @relation(fields: [user_id], references: [work_area_code], onUpdate: Restrict, map: "event_ibfk_1")
  product               product                     @relation(fields: [product_id], references: [id], map: "event_ibfk_2")
  event_approver        event_approver[]
  event_attachment      event_attachment[]
  event_budget          event_budget[]
  event_consultant      event_consultant[]
  notification          notification[]

  @@index([user_id], map: "user_id")
  @@index([type], map: "event_type_id")
  @@index([event_type_id], map: "event_type_id_2")
  @@index([product_id], map: "product_fk")
}

model event_approver {
  id                   String                 @id @default(nanoid()) @db.VarChar(21)
  event_id             String                 @db.VarChar(21)
  user_id              String                 @db.VarChar(21)
  user_role            String                 @db.VarChar(20)
  created_at           DateTime?              @default(now()) @db.Timestamp(0)
  updated_at           DateTime?              @default(now()) @db.Timestamp(0)
  event                event                  @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_approver_ibfk_1")
  user                 user                   @relation(fields: [user_id], references: [work_area_code], onDelete: Cascade, map: "event_approver_ibfk_2")
  event_status_history event_status_history[]

  @@unique([event_id, user_id], map: "event_id")
  @@index([user_id], map: "user_id")
}

model event_attachment {
  id             String    @id @default(nanoid()) @db.VarChar(21)
  event_id       String    @db.VarChar(21)
  document_title String    @db.VarChar(100)
  file_path      String    @db.VarChar(200)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  event          event     @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_attachment_ibfk_1")

  @@index([event_id], map: "event_id")
}

model event_budget {
  id         String    @id @default(nanoid()) @db.VarChar(21)
  event_id   String    @db.VarChar(21)
  item       String    @db.VarChar(100)
  unit       Int
  unit_cost  Decimal   @db.Decimal(10, 2)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  event      event     @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_budget_ibfk_1")

  @@index([event_id], map: "event_id")
}

model event_status_history {
  id                String                      @id @default(nanoid()) @db.VarChar(21)
  event_approver_id String                      @db.VarChar(21)
  status            event_status_history_status
  created_at        DateTime?                   @default(now()) @db.Timestamp(0)
  updated_at        DateTime?                   @default(now()) @db.Timestamp(0)
  remarks           String?                     @db.Text
  event_approver    event_approver              @relation(fields: [event_approver_id], references: [id], onDelete: Cascade, map: "event_status_history_ibfk_1")

  @@index([event_approver_id], map: "event_approver_id")
}

model event_type {
  id          String     @id @default(nanoid()) @db.VarChar(21)
  title       String     @db.VarChar(150)
  lower_limit Decimal?   @default(0.00) @db.Decimal(10, 2)
  upper_limit Decimal?   @default(0.00) @db.Decimal(10, 2)
  created_at  DateTime?  @default(now()) @db.Timestamp(0)
  updated_at  DateTime?  @default(now()) @db.Timestamp(0)
  approver    approver[]
  event       event[]
  events      events[]
}

model product {
  id           String         @id @default(nanoid()) @db.VarChar(21)
  name         String         @db.VarChar(150)
  created_at   DateTime?      @default(now()) @db.Timestamp(0)
  updated_at   DateTime?      @default(now()) @db.Timestamp(0)
  event        event[]
  events       events[]
  product_user product_user[]
  user_product user_product[]
}

model user {
  work_area_code String           @unique(map: "employee_id") @db.VarChar(10)
  created_at     DateTime?        @default(now()) @db.Timestamp(0)
  updated_at     DateTime?        @default(now()) @db.Timestamp(0)
  password       String           @db.VarChar(150)
  role           String           @db.VarChar(20)
  id             String           @id @unique(map: "id") @default(nanoid()) @db.VarChar(21)
  ao             ao?
  ec             ec?
  event          event[]
  event_approver event_approver[]
  flm            flm?
  franchise_head franchise_head?
  marketing      marketing?
  notification   notification[]
  product_user   product_user[]
  slm            slm?
  user_details   user_details?
  user_role      user_role[]
}

model user_details {
  id           String    @id @default(nanoid()) @db.VarChar(21)
  user_id      String    @unique(map: "user_id") @db.VarChar(10)
  full_name    String    @db.VarChar(150)
  department   String    @db.VarChar(50)
  designation  String    @db.VarChar(50)
  region       String    @db.VarChar(50)
  region_id    String    @db.VarChar(10)
  territory_id String    @db.VarChar(10)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @default(now()) @db.Timestamp(0)
  mobile       String    @db.VarChar(14)
  email        String?   @db.VarChar(150)
  user         user      @relation(fields: [user_id], references: [work_area_code], onDelete: Cascade, map: "user_details_ibfk_1")
}

model event_consultant {
  id                        String                                  @id @default(nanoid()) @db.VarChar(21)
  doctor_id                 String                                  @db.VarChar(21)
  event_id                  String                                  @db.VarChar(21)
  duration_h                Decimal                                 @db.Decimal(5, 2)
  role                      String                                  @db.VarChar(100)
  honorarium                Decimal?                                @default(0.00) @db.Decimal(10, 2)
  created_at                DateTime?                               @default(now()) @db.Timestamp(0)
  updated_at                DateTime?                               @default(now()) @db.Timestamp(0)
  in_different_district     event_consultant_in_different_district? @default(yes)
  night_stay                event_consultant_night_stay?            @default(no)
  tier_id                   String?                                 @db.VarChar(21)
  event                     event                                   @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_consultant_ibfk_2")
  doctor                    doctor                                  @relation(fields: [doctor_id], references: [id], map: "event_consultant_ibfk_1")
  event_consultant_approval event_consultant_approval?

  @@unique([doctor_id, event_id], map: "doctor_id")
  @@index([event_id], map: "event_id")
}

model ao {
  full_name      String    @db.VarChar(150)
  designation    String    @db.VarChar(100)
  email          String    @db.VarChar(200)
  group_name     String    @db.VarChar(50)
  rm_code        String    @db.VarChar(6)
  zm_code        String    @db.VarChar(6)
  wing_code      String    @db.VarChar(6)
  work_area_code String    @id @db.VarChar(6)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  employee_id    String?   @default("NULL") @db.VarChar(20)
  user           user      @relation(fields: [work_area_code], references: [work_area_code], onUpdate: Restrict, map: "ao_ibfk_1")
}

model director {
  work_area_code String    @id @db.VarChar(6)
  full_name      String    @db.VarChar(150)
  email          String?   @db.VarChar(150)
  mobile         String?   @db.VarChar(14)
  designation    String?   @db.VarChar(150)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
}

model flm {
  full_name      String    @db.VarChar(150)
  designation    String    @db.VarChar(100)
  email          String?   @db.VarChar(200)
  group_name     String    @db.VarChar(10)
  zm_code        String    @db.VarChar(6)
  wing_code      String    @db.VarChar(6)
  work_area_code String    @id @db.VarChar(6)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  user           user      @relation(fields: [work_area_code], references: [work_area_code], onUpdate: Restrict, map: "flm_ibfk_1")
}

model slm {
  full_name      String    @db.VarChar(150)
  designation    String    @db.VarChar(100)
  email          String?   @db.VarChar(200)
  group_name     String    @db.VarChar(10)
  wing_code      String    @db.VarChar(6)
  work_area_code String    @id @db.VarChar(6)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  user           user      @relation(fields: [work_area_code], references: [work_area_code], onUpdate: Restrict, map: "slm_ibfk_1")
}

model marketing {
  work_area_code String    @id @db.VarChar(20)
  full_name      String    @db.VarChar(150)
  designation    String    @db.VarChar(100)
  email          String    @db.VarChar(200)
  group_name     String    @db.VarChar(10)
  mobile         String?   @db.VarChar(14)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  user           user      @relation(fields: [work_area_code], references: [work_area_code], map: "marketing_ibfk_1")
}

model product_user {
  work_area_code String    @db.VarChar(6)
  product_slug   String    @db.VarChar(150)
  id             String    @id @default(nanoid()) @db.VarChar(21)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  user           user      @relation(fields: [work_area_code], references: [work_area_code], onUpdate: Restrict, map: "product_user_ibfk_1")
  product        product   @relation(fields: [product_slug], references: [id], onDelete: Cascade, map: "product_user_ibfk_2")

  @@unique([product_slug, work_area_code], map: "product_slug")
  @@index([work_area_code], map: "work_area_code")
}

model ec {
  work_area_code String    @id @db.VarChar(10)
  full_name      String    @db.VarChar(150)
  designation    String    @db.VarChar(100)
  email          String?   @db.VarChar(200)
  group_name     String    @db.VarChar(10)
  mobile         String?   @db.VarChar(14)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  user           user      @relation(fields: [work_area_code], references: [work_area_code], onUpdate: Restrict, map: "ec_ibfk_1")
}

model franchise_head {
  full_name      String    @db.VarChar(150)
  designation    String?   @db.VarChar(100)
  email          String    @db.VarChar(200)
  group_name     String    @db.VarChar(10)
  work_area_code String    @id @db.VarChar(6)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  user           user      @relation(fields: [work_area_code], references: [work_area_code], map: "franchise_head_ibfk_1")
}

model role {
  role                             String       @id @db.VarChar(25)
  created_at                       DateTime?    @default(now()) @db.Timestamp(0)
  updated_at                       DateTime?    @default(now()) @db.Timestamp(0)
  user_roles                       user_role[]  @relation("user_roles")
  users_role_users_role_roleTorole users_role[] @relation("users_role_roleTorole")
}

model policy {
  id          String        @id @default(nanoid(10)) @db.VarChar(10)
  name        String        @db.VarChar(100)
  description String?       @db.VarChar(255)
  resource    String        @db.VarChar(30)
  action      String        @db.VarChar(30)
  effect      policy_effect @default(allow)
  conditions  Json?
  priority    Int           @default(0)
  enabled     Boolean       @default(true)
  created_at  DateTime?     @default(now()) @db.Timestamp(0)
  updated_at  DateTime?     @default(now()) @updatedAt @db.Timestamp(0)

  @@index([resource, action], map: "policy_relation_1")
}

model user_role {
  work_area_code String    @db.VarChar(6)
  role           String    @db.VarChar(20)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  user_roles     role      @relation("user_roles", fields: [role], references: [role], map: "user_role_ibfk_2")
  user           user      @relation(fields: [work_area_code], references: [work_area_code], onDelete: Cascade, map: "user_role_ibfk_3")

  @@unique([work_area_code, role], map: "work_area_code")
  @@index([role], map: "role")
}

model event_consultant_approval {
  id                       String                                              @id @default(nanoid()) @db.VarChar(21)
  consultant_Id            String                                              @unique(map: "consultant_Id") @db.VarChar(21)
  topic_expert             event_consultant_approval_topic_expert?
  is_suitable              event_consultant_approval_is_suitable?
  honorarium_check         event_consultant_approval_honorarium_check?
  nth_engagement           Int?
  created_at               DateTime?                                           @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                                           @default(now()) @db.Timestamp(0)
  first_approver_id        String?                                             @db.VarChar(8)
  ec_id                    String?                                             @db.VarChar(8)
  consultant_form_attached event_consultant_approval_consultant_form_attached?
  event_consultant         event_consultant                                    @relation(fields: [consultant_Id], references: [id], onDelete: Cascade, map: "event_consultant_approval_ibfk_1")
}

model honorarium_calculation {
  id                        String                   @id @default(nanoid()) @db.VarChar(21)
  tier_name                 String                   @unique(map: "tier_name") @db.VarChar(21)
  hr_rate                   Decimal                  @db.Decimal(10, 2)
  different_dist_percentage Decimal                  @db.Decimal(3, 2)
  night_stay_percentage     Decimal                  @db.Decimal(3, 2)
  speaker_percentage        Decimal                  @db.Decimal(3, 2)
  created_at                DateTime?                @default(now()) @db.Timestamp(0)
  updated_at                DateTime?                @default(now()) @db.Timestamp(0)
  honorarium_designation    honorarium_designation[]
}

model honorarium_designation {
  id                     String                 @id @default(nanoid()) @db.VarChar(21)
  tier_id                String                 @db.VarChar(21)
  designation            String                 @unique(map: "designation") @db.VarChar(100)
  created_at             DateTime?              @default(now()) @db.Timestamp(0)
  updated_at             DateTime?              @default(now()) @db.Timestamp(0)
  honorarium_calculation honorarium_calculation @relation(fields: [tier_id], references: [id], onDelete: Cascade, map: "honorarium_designation_ibfk_1")

  @@index([tier_id], map: "tier_id")
}

model notification {
  id             String                  @id @default(nanoid()) @db.VarChar(21)
  work_area_code String                  @db.VarChar(8)
  event_id       String                  @db.VarChar(21)
  message        String                  @db.VarChar(200)
  created_at     DateTime?               @default(now()) @db.Timestamp(0)
  updated_at     DateTime?               @default(now()) @db.Timestamp(0)
  is_marked      notification_is_marked? @default(no)
  status         notification_status?    @default(read_only)
  event          event                   @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "notification_ibfk_1")
  user           user                    @relation(fields: [work_area_code], references: [work_area_code], onDelete: Cascade, map: "notification_ibfk_2")

  @@index([event_id], map: "event_id")
  @@index([work_area_code], map: "work_area_code")
}

model area {
  sap_area_code    String       @id @db.VarChar(6)
  area_name        String       @db.VarChar(30)
  created_at       DateTime?    @default(now()) @db.Timestamp(0)
  updated_at       DateTime?    @default(now()) @db.Timestamp(0)
  type             area_type
  parent_area_code String?      @db.VarChar(6)
  area             area?        @relation("areaToarea", fields: [parent_area_code], references: [sap_area_code], onUpdate: SetNull, map: "area_relation_1")
  other_area       area[]       @relation("areaToarea")
  events           events[]
  users_area       users_area[]

  @@index([parent_area_code], map: "area_relation_1")
}

model user_product {
  id          String    @id @default(nanoid(10)) @db.VarChar(10)
  employee_id String    @db.VarChar(10)
  product_id  String    @db.VarChar(21)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  product     product   @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "user_product_relation_1")
  users       users     @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade, map: "user_product_relation_2")

  @@unique([employee_id, product_id], map: "user_product_index_2")
  @@index([product_id], map: "user_product_relation_1")
}

model users {
  employee_id     String            @id @db.VarChar(10)
  full_name       String            @db.VarChar(50)
  password        String            @db.VarChar(100)
  email           String            @db.VarChar(100)
  designation     String            @db.VarChar(50)
  mobile          String?           @db.VarChar(14)
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  updated_at      DateTime?         @default(now()) @db.Timestamp(0)
  group           String?           @db.VarChar(50)
  status          users_status?     @default(active)
  event_approvers event_approvers[]
  events          events[]
  user_product    user_product[]
  users_area      users_area[]
  users_role      users_role[]
}

model users_role {
  id                         String @id @default(nanoid(10)) @db.VarChar(10)
  employee_id                String @db.VarChar(10)
  role                       String @db.VarChar(25)
  users                      users  @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade, map: "users_role_relation_1")
  role_users_role_roleTorole role   @relation("users_role_roleTorole", fields: [role], references: [role], onDelete: Cascade, map: "users_role_relation_2")

  @@unique([employee_id, role], map: "users_role_index_2")
  @@index([role], map: "users_role_relation_2")
}

model users_area {
  id            String @id @default(nanoid(10)) @db.VarChar(10)
  employee_id   String @db.VarChar(10)
  sap_area_code String @db.VarChar(6)
  users         users  @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade, map: "users_area_relation_1")
  area          area   @relation(fields: [sap_area_code], references: [sap_area_code], onDelete: Cascade, map: "users_area_relation_2")

  @@unique([sap_area_code, employee_id], map: "users_area_index_4")
  @@index([employee_id], map: "users_area_relation_1")
}

model event_approvers {
  id                     String                   @id @default(nanoid()) @db.VarChar(21)
  event_id               String                   @db.VarChar(21)
  employee_id            String?                  @db.VarChar(10)
  user_role              String                   @db.VarChar(20)
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                @default(now()) @db.Timestamp(0)
  sap_area_code          String                   @db.VarChar(6)
  events                 events                   @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_approvers_relation_1")
  users                  users?                   @relation(fields: [employee_id], references: [employee_id], onUpdate: SetNull, map: "event_approvers_relation_2")
  event_status_histories event_status_histories[]

  @@unique([event_id, employee_id], map: "event_id")
  @@index([employee_id], map: "event_approvers_relation_2")
}

model event_attachments {
  id             String    @id @db.VarChar(21) @default(nanoid())
  event_id       String    @db.VarChar(21)
  document_title String    @db.VarChar(100)
  file_path      String    @db.VarChar(200)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  events         events    @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_attachments_relation_1")

  @@index([event_id], map: "event_attachments_relation_1")
}

model event_budgets {
  id         String    @id @db.VarChar(21) @default(nanoid())
  event_id   String    @db.VarChar(21)
  item       String    @db.VarChar(100)
  unit       Int
  unit_cost  Decimal   @db.Decimal(10, 2)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  events     events    @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_budgets_relation_1")

  @@index([event_id], map: "event_budgets_relation_1")
}

model event_consultant_approvals {
  id                       String                                               @id @db.VarChar(21) @default(nanoid())
  consultant_Id            String                                               @unique(map: "consultant_Id") @db.VarChar(21)
  topic_expert             event_consultant_approvals_topic_expert?
  is_suitable              event_consultant_approvals_is_suitable?
  honorarium_check         event_consultant_approvals_honorarium_check?
  nth_engagement           Int?
  created_at               DateTime?                                            @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                                            @default(now()) @db.Timestamp(0)
  first_approver_id        String?                                              @db.VarChar(8)
  ec_id                    String?                                              @db.VarChar(8)
  consultant_form_attached event_consultant_approvals_consultant_form_attached?
  event_consultants        event_consultants                                    @relation(fields: [consultant_Id], references: [id], onDelete: Cascade, map: "event_consultant_approvals_relation_1")
}

model event_consultants {
  id                         String                                   @id @db.VarChar(21) @default(nanoid())
  doctor_id                  String                                   @db.VarChar(21)
  event_id                   String                                   @db.VarChar(21)
  duration_h                 Decimal                                  @db.Decimal(5, 2)
  role                       String                                   @db.VarChar(100)
  honorarium                 Decimal?                                 @default(0.00) @db.Decimal(10, 2)
  created_at                 DateTime?                                @default(now()) @db.Timestamp(0)
  updated_at                 DateTime?                                @default(now()) @db.Timestamp(0)
  in_different_district      event_consultants_in_different_district? @default(yes)
  night_stay                 event_consultants_night_stay?            @default(no)
  tier_id                    String?                                  @db.VarChar(21)
  event_consultant_approvals event_consultant_approvals?
  doctor                     doctor                                   @relation(fields: [doctor_id], references: [id], map: "event_consultants_relation_1")
  events                     events                                   @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_consultants_relation_2")

  @@unique([doctor_id, event_id], map: "doctor_id")
  @@index([event_id], map: "event_consultants_relation_2")
}

model event_status_histories {
  id                String                        @id @db.VarChar(21) @default(nanoid())
  event_approver_id String                        @db.VarChar(21)
  status            event_status_histories_status
  created_at        DateTime?                     @default(now()) @db.Timestamp(0)
  updated_at        DateTime?                     @default(now()) @db.Timestamp(0)
  remarks           String?                       @db.Text
  event_approvers   event_approvers               @relation(fields: [event_approver_id], references: [id], onDelete: Cascade, map: "event_status_histories_relation_1")

  @@index([event_approver_id], map: "event_status_histories_relation_1")
}

model events {
  id                    String                       @id @db.VarChar(21) @default(nanoid(10))
  title                 String                       @db.VarChar(250)
  event_date            DateTime                     @db.DateTime(0)
  employee_id           String?                      @db.VarChar(10)
  product_id            String                       @db.VarChar(21)
  venue                 String                       @db.VarChar(255)
  food_supplier         String                       @db.VarChar(200)
  institute             String                       @db.VarChar(250)
  institute_unit        String?                      @db.VarChar(150)
  institute_dept        String                       @db.VarChar(150)
  objective             String                       @db.VarChar(150)
  type                  String                       @db.VarChar(100)
  internal_participants Int
  external_participants Int
  details_participants  String?                      @db.Text
  approved_material     events_approved_material
  material_code         String?                      @db.VarChar(200)
  current_status        events_current_status?       @default(processing)
  created_at            DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at            DateTime?                    @default(now()) @db.Timestamp(0)
  other_participants    Int?
  venue_appropriateness events_venue_appropriateness
  track_no              String?                      @default("NULL") @db.VarChar(50)
  event_type_id         String?                      @db.VarChar(21)
  is_archived           events_is_archived?          @default(no)
  sap_area_code         String                       @db.VarChar(6)
  event_approvers       event_approvers[]
  event_attachments     event_attachments[]
  event_budgets         event_budgets[]
  event_consultants     event_consultants[]
  users                 users?                       @relation(fields: [employee_id], references: [employee_id], onUpdate: SetNull, map: "events_relation_1")
  area                  area                         @relation(fields: [sap_area_code], references: [sap_area_code], onDelete: Cascade, map: "events_relation_2")
  product               product                      @relation(fields: [product_id], references: [id], map: "events_relation_3")
  event_type            event_type?                  @relation(fields: [event_type_id], references: [id], onDelete: Restrict, map: "events_relation_4")

  @@index([type], map: "event_type_id")
  @@index([employee_id], map: "events_relation_1")
  @@index([sap_area_code], map: "events_relation_2")
  @@index([product_id], map: "events_relation_3")
  @@index([event_type_id], map: "events_relation_4")
}

